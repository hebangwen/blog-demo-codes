{
  "name": "@local/magpie-usage",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live Magpie gateway usage in DeepSeek Harness: cost, tokens, quota windows and recent requests, read from the local Magpie gateway.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
